{
	"name": "@buboterrae/mitme",
	"version": "2.0.2",
	"description": "Video Conferencing tool that uses WebRTC through PeerJS",
	"private": false,
	"license": "MIT",
	"lib": [
		"DOM",
		"ESNext"
	],
	"scripts": {
		"lint": "bunx --bun @biomejs/biome check --write --max-diagnostics 100",
		"pack": "tsup"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/BuboTerrae/MitMe.git"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/bun": "^1.4.3",
		"@typescript/typescript6": "^6.0.2",
		"tsup": "^9.0.0"
	},
	"peerDependencies": {
		"typescript": "^6"
	},
	"dependencies": {
		"peerjs": "^1.5.5",
		"zod": "^4.6.7"
	},
	"keywords": [
		"sdk",
		"api",
		"typescript",
		"webrtc",
		"video-conferencing",
		"video"
	],
	"author": "Fatuous Nerd",
	"homepage": "https://github.com/BuboTerrae/MitMe",
	"bugs": {
		"url": "https://github.com/BuboTerrae/MitMe/issues"
	}
}
